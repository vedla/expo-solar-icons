{
  "name": "@vedla/expo-solar-icons",
  "version": "1.0.0",
  "description": "Solar icons for React Native and Expo projects.",
  "keywords": [],
  "license": "ISC",
  "author": {
    "name": "Vedla Creative",
    "email": "code@vedla.ca"
  },
  "type": "commonjs",
  "main": "build/IconsLazy.js",
  "module": "build/Icons.js",
  "types": "build/Icons.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "EXPO_NONINTERACTIVE=1 expo-module build && npm run generate-lazy && npm run copy-vendor",
    "build:dev": "expo-module build",
    "clean": "expo-module clean",
    "copy-vendor": "rm -rf build/solar-icons && cp -R src/solar-icons build/solar-icons",
    "expo-module": "expo-module",
    "generate-lazy": "expo-module babel --config-file ./babel.config.build.js --source-maps --out-file build/IconsLazy.js build/Icons.js",
    "lint": "expo-module lint",
    "prepare": "expo-module prepare && npm run generate-lazy && npm run copy-vendor",
    "prepublishOnly": "expo-module prepublishOnly",
    "test": "expo-module test"
  },
  "jest": {
    "preset": "expo-module-scripts"
  },
  "dependencies": {
    "@expo/vector-icons": ">=14",
    "expo-modules-core": "^57.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "expo": ">=55.0.0",
    "expo-font": ">=55.0.4",
    "prettier": "^3.9.6",
    "react": ">=19.0.0",
    "react-native": ">=0.83.0",
    "typescript": ">=5.2.2"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=14",
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@expo/vector-icons": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.18.0"
}
